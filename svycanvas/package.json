{
  "name": "svycanvas",
  "version": "2025.3.1",
  "description": "Servoy Canvas component",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration production @servoy/svycanvas",
    "build_debug": "ng build @servoy/svycanvas --watch",
    "build_debug_nowatch": "ng build @servoy/svycanvas --watch=false",
    "make_release": "ng build --configuration production @servoy/svycanvas && node scripts/build.js",
    "test": "ng test @servoy/svycanvas --no-watch",
    "test:watch": "ng test @servoy/svycanvas",
    "lint": "ng lint",
    "cy:open": "cypress open",
    "cy:run": "cypress run --config video=false --component --browser chrome",
    "cy:run_spec": "cypress run --config video=false --component --browser chrome --headed --no-exit --spec "
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Servoy/svycanvas.git"
  },
  "keywords": [
    "servoy",
    "canvas"
  ],
  "author": "Tuan Nguyen",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Servoy/svycanvas/issues"
  },
  "homepage": "https://github.com/Servoy/svycanvas#readme",
  "dependencies": {
    "@angular/common": "^22.1.3",
    "@angular/core": "22.1.3",
    "@angular/forms": "22.1.3",
    "@angular/platform-browser": "^22.1.3",
    "@angular/platform-browser-dynamic": "^22.1.3",
    "@angular/router": "^22.1.3",
    "@servoy/public": "^2026.9.2",
    "fabric": "7.4.0",
    "rxjs": "^7.8.2",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.1.0",
    "@angular-eslint/eslint-plugin": "^22.1.0",
    "@angular-eslint/eslint-plugin-template": "^22.1.0",
    "@angular-eslint/template-parser": "^22.1.0",
    "@angular/build": "^22.1.5",
    "@angular/cli": "22.1.5",
    "@angular/compiler": "^22.1.3",
    "@angular/compiler-cli": "22.1.3",
    "@eslint/js": "^10.0.1",
    "adm-zip": "0.6.0",
    "angular-eslint": "^22.1.0",
    "cypress": "^15.21.0",
    "eslint": "10.8.1",
    "eslint-plugin-only-warn": "^1.2.1",
    "istanbul-lib-instrument": "^6.0.3",
    "jsdom": "^30.0.1",
    "ng-packagr": "22.1.1",
    "ts-node": "10.9.2",
    "tslib": "^2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
