{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "cli": {
    "analytics": "c73821cc-c3cd-481c-a275-0657b4a6c943"
  },
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "@servoy/svycanvas": {
      "projectType": "library",
      "root": "project",
      "sourceRoot": "project/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "tsConfig": "project/tsconfig.lib.json",
            "project": "project/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "project/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "project/tsconfig.lib.json"
            }
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "project/tsconfig.spec.json",
            "runner": "vitest",
            "exclude": ["**/*.browser.spec.ts"]
          }
        },
        "test-browser": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "project/tsconfig.spec.json",
            "runner": "vitest",
            "browsers": ["chromium"],
            "headless": true,
            "include": ["project/src/**/*.browser.spec.ts"]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "project/src/**/*.ts",
              "project/src/**/*.html"
            ]
          }
        }
      }
    },
    "dummy": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/dummy",
      "sourceRoot": "projects/dummy/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/dummy",
            "index": "projects/dummy/src/index.html",
            "browser": "projects/dummy/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/dummy/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/dummy/public"
              }
            ],
            "styles": [
              "projects/dummy/src/styles.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "testing": {
              "aot": false,
              "optimization": false,
              "extractLicenses": false,
              "polyfills": [
                "zone.js",
                "zone.js/testing"
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "dummy:build:production"
            },
            "development": {
              "buildTarget": "dummy:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        }
      }
    }
  },
  "schematics": {
    "@angular-eslint/schematics:application": {
      "setParserOptionsProject": true
    },
    "@angular-eslint/schematics:library": {
      "setParserOptionsProject": true
    },
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
