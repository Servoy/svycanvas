{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "../out-tsc/lib",
    "target": "es2017",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "allowJs": true,
    "noImplicitAny": false,
    "types": []
  },
  "angularCompilerOptions": {
    "skipTemplateCodegen": true,
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    },
    "strictMetadataEmit": true,
    "enableResourceInlining": true
  },
  "exclude": [
    "src/test.ts",
    "**/*.cy.ts"
  ]
}
